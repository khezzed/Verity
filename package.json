{
  "name": "verity",
  "version": "1.0.0",
  "description": "Verity: Risk-Limiting Sequential Audit Protocol (Wald SPRT) for Citation & Claim Grounding on GenLayer",
  "type": "module",
  "scripts": {
    "probe:studionet": "tsx scripts/probe_studionet.ts",
    "deploy:studionet": "tsx scripts/deploy_and_seed.ts",
    "seed:case5": "tsx scripts/seed_case5.ts",
    "verify:proof": "tsx scripts/verify_proof.ts",
    "test:unit": "node -e \"const {execFileSync}=require('child_process');const p=process.platform==='win32'?'.venv\\\\Scripts\\\\pytest.exe':'.venv/bin/pytest';execFileSync(p,['tests','-v'],{stdio:'inherit'})\"",
    "test:direct": "npm run test:unit",
    "frontend:dev": "npm --prefix frontend run dev",
    "frontend:build": "npm --prefix frontend run build"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/khezzed/Verity.git"
  },
  "license": "MIT",
  "dependencies": {
    "genlayer-js": "^1.2.0",
    "viem": "^2.21.0"
  },
  "devDependencies": {
    "@types/node": "^22.8.1",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
